<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Uml4Net.Sage.Tools</RootNamespace>
    <AssemblyName>uml4net-sage</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Assembly">
    <!-- Hypha's Package group, with the .NET tool, and the rest of its Publish group come with the
         release in Phase 5 (#49). -->
    <Description>
      Fetches the OMG UML and XMI specifications, generates a local knowledge base from them
      (metamodel, Standard Profile, specification text) and checks UML model files against it, with
      JSON output for editors and language-model tools.
    </Description>
    <Authors>Starion Group S.A.</Authors>
    <Company>Starion Group S.A.</Company>
    <Copyright>Copyright 2026 Starion Group S.A.</Copyright>
    <RepositoryUrl>https://github.com/STARIONGROUP/uml4net-sage</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
  </PropertyGroup>

  <PropertyGroup Label="Publish">
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Serilog" />
    <PackageReference Include="Serilog.Extensions.Logging" />
    <PackageReference Include="Serilog.Sinks.Console" />
    <PackageReference Include="Spectre.Console" />
    <PackageReference Include="System.CommandLine" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\inspection\Uml4Net.Sage.Inspection\Uml4Net.Sage.Inspection.csproj" />
    <ProjectReference Include="..\..\knowledge-gen\Uml4Net.Sage.Knowledge\Uml4Net.Sage.Knowledge.csproj" />
    <ProjectReference Include="..\..\metamodel-gen\Uml4Net.Sage.Knowledge.Metamodel\Uml4Net.Sage.Knowledge.Metamodel.csproj" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Uml4Net.Sage.Tools.Tests" />
  </ItemGroup>

</Project>
