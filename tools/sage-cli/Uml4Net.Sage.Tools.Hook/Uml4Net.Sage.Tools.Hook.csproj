<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <!-- Deliberately dependency-free (see CLAUDE.md): this binary is committed to the plugin repo and
         must stay small and NativeAOT-publishable. It only provisions/launches the full CLI; it never
         parses XMI or PDFs itself. -->
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <PublishAot>true</PublishAot>
    <InvariantGlobalization>true</InvariantGlobalization>
    <RootNamespace>Uml4Net.Sage.Tools.Hook</RootNamespace>
    <AssemblyName>uml4net-sage-hook</AssemblyName>
  </PropertyGroup>

</Project>
