<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>Uml4Net.Sage.Knowledge</RootNamespace>
    <AssemblyName>Uml4Net.Sage.Knowledge</AssemblyName>
  </PropertyGroup>

  <PropertyGroup Label="Assembly">
    <!-- Not a package of its own: the uml4net-sage CLI carries it. -->
    <IsPackable>false</IsPackable>
    <Description>
      The uml4net-sage knowledge base: the registry of UML and XMI specification versions, fetching
      their sources from omg.org, generating the knowledge from them, and recording what is installed.
    </Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Http" />
    <PackageReference Include="Microsoft.Extensions.Http.Polly" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
    <PackageReference Include="Polly" />
    <PackageReference Include="Polly.Extensions.Http" />
  </ItemGroup>

  <ItemGroup>
    <!-- Until #60 turns the reference round, as hypha's: the generator collection then runs the
         metamodel generator, and the knowledge library knows nothing of uml4net. -->
    <ProjectReference Include="..\..\metamodel-gen\Uml4Net.Sage.Knowledge.Metamodel\Uml4Net.Sage.Knowledge.Metamodel.csproj" />
  </ItemGroup>

</Project>
