			<ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="FuelKind-petrol" name="Petrol"/>
			<ownedLiteral xmi:type="uml:EnumerationLiteral" xmi:id="FuelKind-electric" name="Electric"/>
		</packagedElement>
	</uml:Package>
</xmi:XMI>
