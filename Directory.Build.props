<Project>

  <!-- Shared MSBuild properties imported at the top of every project in the solution. mycelium-hypha
       has no Directory.Build.props and opens each project file with these four properties; uml4net-sage
       keeps them here instead (sage-mcp-refactor-plan.md, section 2.10), with hypha's values. Everything
       else hypha sets per project (RootNamespace, AssemblyName, the Assembly group, the test packages,
       IsPackable) stays in each project file, as hypha has it. -->

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <!-- Hypha enables implicit usings; Sage writes every using out (section 2.10). -->
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

</Project>
